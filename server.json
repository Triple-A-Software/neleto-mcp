{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.neleto/cms",
  "title": "Neleto CMS",
  "description": "Create and edit pages, posts, events, files and layouts on your Neleto CMS site. EU-hosted.",
  "version": "1.18.0",
  "websiteUrl": "https://neleto.io/docs/developer/mcp",
  "repository": {
    "url": "https://github.com/Triple-A-Software/neleto-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://neleto.io/favicon.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://{instance_host}/api/mcp",
      "variables": {
        "instance_host": {
          "description": "Host of your Neleto site, e.g. mysite.free.neleto.io or www.example.com",
          "isRequired": true
        }
      }
    }
  ]
}
